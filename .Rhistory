data %>%
mutate(monotonic = case_when(`-demand_5` <= `-demand_4` <= `-demand_3` <= energy_price <=
# check that all changes to demand are weakly monotonic
data %>%
mutate(monotonic = case_when((`-demand_5` <= `-demand_4`) &
(`-demand_4` <= `-demand_3`) &
(`-demand_3` <= energy_price) &
(energy_price <= `+demand_1`) &
(`+demand_1` <= `+demand_2`) &
(`+demand_2` <= `+demand_3`) &
(`+demand_3` <= `+demand_4`) &
(`+demand_4` <= `+demand_5`) ~ 1,
TRUE ~ 0)) %>%
filter(monotonic != 1)
?round
# check that all changes to demand are weakly monotonic
data %>%
mutate(monotonic = case_when((`-demand_5` <= `-demand_4` + 0.00001) &
(`-demand_4` <= `-demand_3` + 0.00001) &
(`-demand_3` <= energy_price + 0.00001) &
(energy_price <= `+demand_1` + 0.00001) &
(`+demand_1` <= `+demand_2` + 0.00001) &
(`+demand_2` <= `+demand_3` + 0.00001) &
(`+demand_3` <= `+demand_4` + 0.00001) &
(`+demand_4` <= `+demand_5` + 0.00001) ~ 1,
TRUE ~ 0)) %>%
filter(monotonic != 1)
